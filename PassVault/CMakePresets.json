{
  "version": 6,
  "configurePresets": [
    {
      "name": "xcode",
      "displayName": "Xcode project",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/xcode"
    },
    {
      "name": "asan",
      "displayName": "Terminal build with sanitizers",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer"
      }
    }
  ],
  "buildPresets": [
    { "name": "xcode", "configurePreset": "xcode" },
    { "name": "asan", "configurePreset": "asan" }
  ]
}
